{
  "name": "digital-power-monitor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/vinext.mjs dev",
    "dev:api": "tsx server/index.ts",
    "build": "node scripts/vinext.mjs build",
    "start": "node scripts/start.mjs",
    "start:web": "node scripts/vinext.mjs start",
    "start:api": "tsx server/index.ts",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test:server": "tsx --test tests/*.test.ts",
    "test:build": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "cheerio": "1.1.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "next": "16.2.6",
    "playwright-core": "1.55.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/archiver": "6.0.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
